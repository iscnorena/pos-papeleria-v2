# Copia este archivo a .env.local y llena los valores.
# .env.local está en .gitignore y NO debe subirse al repo.

# Supabase → Project Settings → Database → Connection string → "Transaction pooler".
# Debe ser la cadena del POOLER (puerto 6543), no la directa (5432): las funciones
# serverless abren y cierran conexiones constantemente y agotarían la directa.
DATABASE_URL=

# Supabase → Project Settings → Data API
SUPABASE_URL=
# Llave de servicio: SOLO servidor, nunca con prefijo NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# Secreto de sesión de Auth.js. Genera uno con: openssl rand -base64 32
AUTH_SECRET=

# Nombre del negocio, se muestra en login y tickets
POS_COMPANY_NAME=

# Fase 7 — bancos de imágenes de AcomodaImpresion.
# También solo servidor: la búsqueda pasa por un Route Handler (§7.6).
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=
PIXABAY_API_KEY=
