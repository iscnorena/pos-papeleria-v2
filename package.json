    "next": "16.3.0",
    "next-auth": "^5.0.0-beta.32",
    "pdf-lib": "^1.17.1",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
